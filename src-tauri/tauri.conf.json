{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shettar Business",
  "version": "0.1.54",
  "identifier": "com.shettar.business",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "pnpm dev:host",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Shettar Business",
        "width": 800,
        "height": 600,
        "resizable": true,
        "maximized": true,
        "backgroundColor": "#f8fafc",
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwQkE0RDRCODQ5RjYyQTEKUldTaFlwK0VTMDI2Y1BBNjdCbFlLdlh5OEV3RW8vcFZKb3BheUdOdUNHZ1dKT0lnaXE2REFVNkUK",
      "endpoints": [
        "https://api-v1.shettar.com/api/v1/updates/{{target}}/{{arch}}/{{current_version}}?channel=production"
      ]
    }
  }
}
