{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shettar Business",
  "version": "0.1.32",
  "identifier": "com.shettar.business",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "pnpm dev -p 3001",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Shettar Business",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0MDYyMjE1RDJFMkFBNkMKUldSc3F1TFNGU0lHRlB3dGQrLzFDanBRN29LeWJsdW9xL25DZExpTDd0VlVUa1dNa0J0T3h4UjAK",
      "endpoints": [
        "https://api-v1.shettar.com/api/v1/updates/{{target}}/{{arch}}/{{current_version}}?channel=production"
      ]
    }
  }
}