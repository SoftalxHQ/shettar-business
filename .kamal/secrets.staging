# Secrets for shettar-business Kamal staging deploys.
# Used with: bin/kamal deploy -d staging
# (loads config/deploy.staging.yml + this file)
#
# - config/registry.yml → Docker Hub token (same as production)
# - .env.staging        → NEXT_PUBLIC_* build-args
#
# IMPORTANT: This file is dotenv, not a shell script. No if/fi/else.

KAMAL_REGISTRY_PASSWORD=$(ruby -e 'print File.read("config/registry.yml").strip')

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=$(sed -n 's/^NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=//p' .env.staging 2>/dev/null | head -1)
NEXT_PUBLIC_WEB_URL=$(sed -n 's/^NEXT_PUBLIC_WEB_URL=//p' .env.staging 2>/dev/null | head -1)
